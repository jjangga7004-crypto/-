// ==========================================
// 비서진 · 피드백/채팅 Serverless Function
// POST /api/feedback
// ==========================================

export const config = {
  runtime: 'edge'
};

const FEEDBACK_SYSTEM = `당신은 사용자의 일일 브리핑을 만든 비서진이다. 사용자가 피드백을 주면 짧고 직설적으로 답하고, 다음 브리핑에 반영한다.

# 응답 원칙
- 한국어 반말, 짧고 명확하게 (2-4 문장).
- 피드백 받으면 "다음부터 반영" 식으로 확인.
- 사용자가 특정 부분 다시 분석 요청하면, 그 자리에서 깊이 분석해주기 (이때만 길게).
- 위로/감정 단어 X.

# 컨텍스트 업데이트
사용자 피드백에서 영구 반영할 사항(예: "스포츠 빼" → 분야 로테이션 변경)을 감지하면, 응답 JSON에 contextUpdate 필드로 변경사항을 넣는다.

# 출력 형식 (JSON)
{
  "reply": "사용자에게 보여줄 답변 (한국어)",
  "contextUpdate": { "rotation": "수정된 분야 목록" }  // 영구 변경사항 있을 때만
}`;

export default async function handler(req) {
  if (req.method !== 'POST') {
    return new Response('Method not allowed', { status: 405 });
  }

  try {
    const { context, lastBriefing, message, history } = await req.json();
    const apiKey = process.env.ANTHROPIC_API_KEY;

    if (!apiKey) {
      return new Response('ANTHROPIC_API_KEY 환경변수 누락', { status: 500 });
    }

    const contextText = `
사용자 컨텍스트:
${JSON.stringify(context, null, 2)}

최근 받은 브리핑 (참고용, 앞부분만):
${(lastBriefing || '').substring(0, 2000)}...

사용자 피드백:
${message}

이전 대화:
${(history || []).slice(-6).map(h => `${h.role}: ${h.content}`).join('\n')}
`;

    const response = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-api-key': apiKey,
        'anthropic-version': '2023-06-01'
      },
      body: JSON.stringify({
        model: 'claude-opus-4-7',
        max_tokens: 2000,
        system: FEEDBACK_SYSTEM,
        messages: [{ role: 'user', content: contextText }]
      })
    });

    if (!response.ok) {
      const errText = await response.text();
      return new Response(`Claude API 에러: ${response.status} - ${errText}`, { status: 500 });
    }

    const data = await response.json();
    const text = data.content.filter(b => b.type === 'text').map(b => b.text).join('');

    // JSON 파싱 시도
    let result = { reply: text };
    try {
      const jsonMatch = text.match(/\{[\s\S]*\}/);
      if (jsonMatch) {
        const parsed = JSON.parse(jsonMatch[0]);
        if (parsed.reply) result = parsed;
      }
    } catch (e) {
      // 파싱 실패해도 원본 text를 reply로 사용
    }

    return new Response(JSON.stringify(result), {
      status: 200,
      headers: { 'Content-Type': 'application/json' }
    });

  } catch (err) {
    return new Response(`서버 에러: ${err.message}`, { status: 500 });
  }
}
